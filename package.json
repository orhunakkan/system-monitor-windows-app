{
  "name": "system-monitor-resources",
  "productName": "System Monitor",
  "version": "1.0.0",
  "description": "Windows port of the GNOME System Monitor Resources view",
  "license": "GPL-2.0-or-later",
  "author": "Orhun Akkan",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "dist:win": "node scripts/build-win.js"
  },
  "dependencies": {
    "koffi": "3.3.1"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "io.github.orhunakkan.SystemMonitorResources",
    "productName": "System Monitor",
    "copyright": "GPL-2.0-or-later. Based on GNOME System Monitor 46.0.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "LICENSE",
      "package.json",
      "!**/node_modules/@koromix/**",
      "!**/node_modules/koffi/{doc,vendor,src/cnoke,cnoke.cjs}/**"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "extraResources": [
      {
        "from": "build/vendor/koffi-win32-x64/win32_x64",
        "to": "koffi/win32_x64"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "System Monitor",
      "license": "LICENSE",
      "artifactName": "System-Monitor-Setup-${version}.exe"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
